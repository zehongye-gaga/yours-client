{
  "name": "@deepseek-ai/dsh-subprocess-local",
  "description": "Local-subprocess implementation of the DeepSeek Harness subprocess seam",
  "version": "0.2.1-rc.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subprocess/subprocess-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runner": {
      "types": "./lib/bin.d.ts",
      "default": "./lib/bin.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./output": {
      "types": "./lib/output.d.ts",
      "default": "./lib/output.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "locale",
    "scripts"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-spawn-helper.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-timeout": "workspace:*",
    "cordis": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-lazy-require": "workspace:*",
    "@deepseek-ai/dsh-win32-process": "workspace:*",
    "koffi": "3.1.1",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-timeout": "workspace:*",
    "cordis": "workspace:*",
    "execa": "^10.0.1",
    "tsx": "^4.23.13"
  },
  "private": true
}
